# Получить у https://t.me/BotFather. Не отправляйте токен другим людям.
BOT_TOKEN=

# Пусто = доступ всем. Для личного бота укажите ID через запятую.
# Свой ID покажет команда /id. Пример: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# 360 / 480 / 720 / 1080 / best. Каждый пользователь может изменить через /quality.
DEFAULT_QUALITY=720
MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUE_SIZE=10

# MB здесь = 1 000 000 байт. Большие ролики отправляются частями.
MAX_DOWNLOAD_MB=500
MAX_UPLOAD_MB=49
MAX_DURATION_SECONDS=3600
MAX_PARTS=30
JOB_TIMEOUT_SECONDS=1800
COOLDOWN_SECONDS=5
DATA_DIR=data

# Необязательно: путь к cookies.txt в формате Netscape.
# Файл добавляет только владелец на сервере; через Telegram cookies не принимаются.
# В Docker положите файл в secrets/cookies.txt и задайте /app/secrets/cookies.txt.
COOKIES_FILE=

# Необязательно: корневой URL собственного Telegram Bot API, БЕЗ /bot.
# Например: http://127.0.0.1:8081
# При его использовании MAX_UPLOAD_MB можно поднять до 1950.
LOCAL_BOT_API_URL=
